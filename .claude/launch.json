{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8765",
        "--no-access-log",
        "--reload"
      ],
      "port": 8765,
      "env": {
        "DATABASE_URL": "postgresql+psycopg://ttt:ttt@localhost:55432/ttt",
        "COOKIE_SECURE": "false"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "env": {
        "API_URL": "http://127.0.0.1:8765"
      },
      "port": 5174
    }
  ]
}