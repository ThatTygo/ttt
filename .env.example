# Je domein, zonder https:// en zonder www.
DOMAIN=traumatramtellers.nl
# Verzin een lang, willekeurig wachtwoord (bijv. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# --- E-mail voor Pimpy-taken (optioneel) ---
# Laat SMTP_HOST leeg om geen mails te versturen.
# Postfix op deze server zelf: SMTP_HOST=host.docker.internal, SMTP_PORT=25,
#   SMTP_SECURITY=none, SMTP_USER en SMTP_PASSWORD leeg (zie README).
# Externe mailserver met login: poort 465 + ssl, of poort 587 + starttls.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Afzender, bijv. Trauma Tram Tellers <ict@traumatramtellers.nl>
SMTP_FROM=
